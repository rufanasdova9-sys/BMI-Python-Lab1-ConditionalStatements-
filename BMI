a= float(input("weight in kilograms:"))
b= float(input("height in meters:"))
BMI=a/(b**2)
if BMI < 18.5 :
    print("category: under weight") 
elif  18.5<= BMI <= 24.9 :
    print("category: normal weight")
elif 25.0 <= BMI <= 29.9 :
   print("category: overweight")
else:
    print("category: obese")
